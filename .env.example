# Convex Configuration
# ====================

# Production deploy key (required for Vercel/Production deployments)
# Get it from: https://dashboard.convex.dev/project/settings#production-deploy-keys
CONVEX_DEPLOY_KEY=

# Your Convex site URL (required for auth provider)
# Format: https://<your-project-id>.convex.cloud
# Find it in Convex Dashboard → Settings
CONVEX_SITE_URL=
